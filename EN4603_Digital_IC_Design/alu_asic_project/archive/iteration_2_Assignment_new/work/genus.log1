           [-user_derate] [-gui] [-max_paths <integer>] [-nworst <integer>] [-logic_levels <integer>] [-skip_buf] [-skip_inv] [-max_slack <delay in picoseconds>]
           [-min_slack <delay in picoseconds>] [-paths <string>] [-domain <clock_domain>] [-views <analysis_view>+]
           [ -from <inst|hinst|external_delay|clock|port|pin|hpin>+ |
